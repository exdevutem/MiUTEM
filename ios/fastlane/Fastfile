import "../fastlane/src/helpers.rb"

require "json"
require "tmpdir"

# Busca un simulador por nombre y devuelve [udid, nombre real], prefiriendo el runtime de
# iOS más nuevo. El nombre puede ser un prefijo ("iPad Air 13-inch" toma el M2, M3 o M4
# según el Xcode del runner, que cambia con cada versión).
def ios_simulator(name)
  devices = JSON.parse(sh("xcrun", "simctl", "list", "devices", "available", "--json", log: false))["devices"]
  runtimes = devices.keys.sort_by { |runtime| runtime.scan(/\d+/).map(&:to_i) }.reverse
  disponibles = runtimes.flat_map { |runtime| devices[runtime] }
  device = disponibles.find { |d| d["name"] == name } || disponibles.find { |d| d["name"].start_with?(name) }

  UI.user_error!("❌ No existe el simulador '#{name}'. Créalo en Xcode o ajusta SCREENSHOT_DEVICES.") unless device

  [device["udid"], device["name"]]
end

platform :ios do
  desc "Asegura que exista un keychain limpio para importar los certificados de Apple"
  lane :ensure_keychain do |options|
    keychain_name = string_option(options, :keychain_name, env_var: "KEYCHAIN_NAME", required: true)
    keychain_password = string_option(options, :keychain_password, env_var: "KEYCHAIN_PASSWORD", required: true)

    delete_keychain(name: keychain_name) if File.exist? File.expand_path("~/Library/Keychains/#{keychain_name}")
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      unlock: true,
      timeout: 0,
      default_keychain: true,
      add_to_search_list: true
    )
  end

  desc "Asegura que exista los certificados de Apple en el keychain para que match funcione correctamente"
  lane :ensure_wwdr do |options|
    keychain_name = string_option(options, :keychain_name, env_var: "KEYCHAIN_NAME", required: true)

    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    wwdr_certs = {
      "AppleWWDRCAG3.cer" => "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer",
      "AppleWWDRCAG6.cer" => "https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer",
      "AppleRootCA.cer"   => "https://www.apple.com/appleca/AppleIncRootCertificate.cer",
    }

    wwdr_certs.each do |filename, url|
      path = "/tmp/#{filename}"
      sh("curl", "-fsSL", "-o", path, url) unless File.exist?(path)
      sh("security", "import", path, "-k", keychain_path, "-T", "/usr/bin/codesign")
    end
  end

  desc "Sincroniza certificados y perfiles de aprovisionamiento"
  lane :sync_certificates do |options|
    # Required options
    readonly = bool_option(options, :readonly, env_var: "IS_CI", default: false)
    type = string_option(options, :type, env_var: "MATCH_TYPE", required: true)
    app_identifier = string_option(options, :app_identifier, env_var: "APP_IDENTIFIER", required: true)
    keychain_name = string_option(options, :keychain_name, env_var: "KEYCHAIN_NAME", required: true)
    keychain_password = string_option(options, :keychain_password, env_var: "KEYCHAIN_PASSWORD", required: true)
    match_repo = string_option(options, :match_repo, env_var: "MATCH_REPO", required: true)

    # Skip options
    skip_keychain_setup = bool_option(options, :skip_keychain_setup, env_var: "SKIP_KEYCHAIN_SETUP", default: false)
    skip_wwdr_setup = bool_option(options, :skip_wwdr_setup, env_var: "SKIP_WWDR_SETUP", default: false)

    unless skip_keychain_setup
      ensure_keychain()
    end

    unless skip_wwdr_setup
      ensure_wwdr()
    end

    match(
      app_identifier: [app_identifier],
      type: type,
      platform: "ios",
      git_url: match_repo,
      readonly: readonly,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )
  end

  desc "Configura Signing Settings para Xcode"
  lane :configure_signing do |options|
    # Required options
    match_type = string_option(options, :match_type, env_var: "MATCH_TYPE", required: true)
    app_identifier = string_option(options, :app_identifier, env_var: "APP_IDENTIFIER", required: true)
    team_id = string_option(options, :team_id, env_var: "TEAM_ID", required: true)

    # Computed variables
    profile_type = case match_type
                    when "development" then "Development"
                    when "appstore" then "AppStore"
                    when "ad-hoc" then "AdHoc"
                    when "enterprise" then "Enterprise"
                    else "Unknown"
                   end
    profile_name = "match #{profile_type} #{app_identifier}"
    code_sign_identity = match_type == "development" ? "Apple Development" : "Apple Distribution"

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "./ios/Runner.xcodeproj",
      team_id: team_id,
      bundle_identifier: app_identifier,
      profile_name: profile_name,
      code_sign_identity: code_sign_identity
    )
  end

  desc "Compila la app con flutter para iOS"
  lane :flutter_build do |options|
    # Required options
    app_env = string_option(options, :app_env, env_var: "APP_ENV", default: "dev")
    skip_clean = bool_option(options, :skip_clean, env_var: "SKIP_CLEAN", default: false)
    skip_pods = bool_option(options, :skip_pods, env_var: "SKIP_PODS", default: false)
    version = string_option(options, :version, env_var: "APP_VERSION")
    build_number = string_option(options, :build_number, env_var: "APP_BUILD_NUMBER")

    # Computed variables
    scheme = app_env == "prod" ? "production" : "development"
    target = scheme == "production" ? "lib/main_prod.dart" : "lib/main_dev.dart"

    unless skip_clean
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
    end

    unless skip_pods
      cocoapods(use_bundle_exec: false, podfile: "ios")
    end

    command = ["flutter", "build", "ios", "--release", "--no-codesign", "--flavor=#{scheme}", "--target=#{target}", "--config-only"]
    command << "--build-name=#{version}" if version && !version.empty?
    command << "--build-number=#{build_number}" if build_number && !build_number.empty?

    sh(*command)
  end

  desc "Construye y firma la app para distribución en iOS"
  lane :build do |options|
    # Required options
    app_env = string_option(options, :app_env, env_var: "APP_ENV", default: "dev")
    match_type = string_option(options, :match_type, env_var: "MATCH_TYPE", required: true)
    app_identifier = string_option(options, :app_identifier, env_var: "APP_IDENTIFIER", required: true)
    team_id = string_option(options, :team_id, env_var: "TEAM_ID", required: true)
    is_ci = bool_option(options, :is_ci, env_var: "IS_CI", default: false)

    # Skip options
    skip_flutter_build = bool_option(options, :skip_flutter_build, env_var: "SKIP_FLUTTER_BUILD", default: false)
    skip_build_app = bool_option(options, :skip_build_app, env_var: "SKIP_BUILD_APP", default: false)
    skip_configure_signing = bool_option(options, :skip_configure_signing, env_var: "SKIP_CONFIGURE_SIGNING", default: false)

    unless skip_flutter_build
      flutter_build()
    end

    scheme = app_env == "prod" ? "production" : "development"

    sync_certificates()

    unless skip_build_app
      profile_type = case match_type
                    when "development" then "Development"
                    when "appstore" then "AppStore"
                    when "ad-hoc" then "AdHoc"
                    when "enterprise" then "Enterprise"
                    else "Development"
                   end
      profile_name = "match #{profile_type} #{app_identifier}"

      configure_signing() unless skip_configure_signing

      build_ios_app(
        scheme: scheme,
        export_method: "app-store", # Siempre app-store para subir a la appstore.
        workspace: "./ios/Runner.xcworkspace",
        output_directory: "./build/ios/ipa",
        output_name: "MiUTEM.ipa",
        xcodebuild_formatter: is_ci ? "xcbeautify --renderer github-actions" : "xcbeautify",
      )
    end
  end

  # El recorrido lo maneja snapshot con los UI Tests de Apple, como indica la guía de
  # fastlane (docs.fastlane.tools/getting-started/ios/screenshots): vive en
  # ios/RunnerUITests/ScreenshotsUITests.swift, se configura en fastlane/Snapfile y deja
  # las capturas en fastlane/screenshots/<idioma>/ con el nombre "<Dispositivo>-<pantalla>.png",
  # que es de donde frameit y deliver deducen el dispositivo.
  desc "Genera las capturas de pantalla de iPhone y iPad en el simulador y las guarda en fastlane/screenshots"
  lane :screenshots do |options|
    # La App Store pide un juego por tamaño de pantalla: el iPhone más grande y un iPad de
    # 13". El iPad Air es el único de ese tamaño que da 2048x2732, la resolución que frameit
    # sabe enmarcar (los iPad Pro M4 en adelante dan 2064x2752 y frameit no los conoce).
    devices = array_option(options, :devices, env_var: "SCREENSHOT_DEVICES", default: ["iPhone 17 Pro Max", "iPad Air 13-inch"])
    locale = string_option(options, :locale, env_var: "SCREENSHOT_LOCALE", default: "es-MX")
    app_env = string_option(options, :app_env, env_var: "APP_ENV", default: "prod")
    clear = bool_option(options, :clear, env_var: "SCREENSHOT_CLEAR", default: true)
    frame = bool_option(options, :frame, env_var: "SCREENSHOT_FRAME", default: true)

    scheme = app_env == "prod" ? "production" : "development"
    # APP_ENV suele quedar en dev en el .env local, y las capturas de la tienda tienen que
    # salir del flavor de producción (nombre, ícono y bundle id distintos).
    UI.important("⚠️  Capturando el flavor #{scheme}. Para la App Store usa `app_env:prod`.") unless app_env == "prod"

    # Ruta absoluta: el CWD de un lane es la carpeta fastlane/, no la raíz del repo.
    root = sh("git", "rev-parse", "--show-toplevel", log: false).strip
    screenshots_dir = File.join(root, "fastlane", "screenshots")
    output_dir = File.join(screenshots_dir, locale)

    # Se borran sólo las imágenes: en la carpeta del idioma también vive el title.strings de frameit.
    Dir.glob(File.join(output_dir, "*.png")).each { |captura| File.delete(captura) } if clear
    FileUtils.mkdir_p(output_dir)

    # Cada dispositivo se enmarca solo en la carpeta y recién al final se juntan todos: los
    # fondos y el marco salen del tamaño de las capturas que estén ahí, así que mezclar
    # iPhone con iPad dejaría a uno de los dos con los fondos recortados del otro.
    listas = Dir.mktmpdir("miutem-capturas")

    # El paso de símbolos de Crashlytics que agrega flutterfire saca la carpeta de paquetes
    # de Swift de $BUILD_ROOT: le recorta todo lo que venga después de "DerivedData/<algo>"
    # y busca ahí SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run. snapshot compila
    # en una carpeta temporal (/var/folders/.../snapshot_derived*), que no tiene ese tramo en
    # la ruta, así que el recorte no hace nada y el script termina buscando los checkouts
    # dentro de Build/Products, donde xcodebuild no los deja: la fase se cae con
    # "PhaseScriptExecution FlutterFire: upload-crashlytics-symbols" y no llega a correr ni
    # un test. Con la carpeta fija se puede dejar el enlace donde el script lo espera, que es
    # lo mismo que hace el lane de macOS.
    derived_data = File.join(root, "build", "ios-capturas")
    productos = File.join(derived_data, "Build", "Products")
    FileUtils.mkdir_p(productos)
    FileUtils.ln_sf(File.join(derived_data, "SourcePackages"), File.join(productos, "SourcePackages"))

    # Antes de compilar, snapshot pregunta por los ajustes con `xcodebuild -showBuildSettings`,
    # y eso en este proyecto resuelve primero todos los paquetes de Swift (Firebase incluido):
    # en un runner frío no alcanza a responder en los 3 segundos que fastlane espera por
    # defecto, ni en los 4 reintentos que hace doblando el plazo. La palanca es esta variable.
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "180"

    # snapshot compila con xcodebuild, que no sabe nada de `--dart-define`. `--config-only`
    # no compila: deja el punto de entrada y los defines en ios/Flutter/Generated.xcconfig,
    # y de ahí los toma la fase de compilación de Flutter cuando xcodebuild construye la app.
    #
    # SCREENSHOT_MODE hace que la app use los datos ficticios de lib/core/mock/ en vez de
    # conectarse a SIGA y Mi.UTEM: no se necesita ninguna cuenta real.
    sh(
      "flutter", "build", "ios",
      "--config-only",
      "--simulator",
      "--debug",
      "--flavor=#{scheme}",
      "--target=#{scheme == 'production' ? 'lib/main_prod.dart' : 'lib/main_dev.dart'}",
      "--dart-define=SCREENSHOT_MODE=true"
    )

    devices.each do |device|
      udid, nombre = ios_simulator(device)
      UI.message("📱 Preparando #{nombre} (#{udid})")
      sh("xcrun", "simctl", "bootstatus", udid, "-b")

      # El resto de las opciones (scheme, configuración, xcargs) están en fastlane/Snapfile.
      # El nombre del simulador va resuelto, no el prefijo con el que se pidió: snapshot
      # busca el dispositivo por nombre exacto y así se elige el runtime más nuevo.
      capture_ios_screenshots(
        workspace: File.join(root, "ios", "Runner.xcworkspace"),
        devices: [nombre],
        languages: [locale],
        output_directory: screenshots_dir,
        scheme: scheme,
        configuration: "Debug-#{scheme}",
        derived_data_path: derived_data,
      )

      # Un test que se cuelga y agota el tiempo igual deja el lane en verde sin escribir
      # nada, así que se verifica el resultado.
      capturas = Dir.glob(File.join(output_dir, "*.png"))
      UI.user_error!("❌ No se generó ninguna captura de #{nombre}. Revisa el log de snapshot.") if capturas.empty?

      if frame
        # Los fondos se cortan al tamaño exacto de las capturas: si cambia el simulador
        # cambia el tamaño, y frameit recortaría las tiras y rompería la continuidad.
        sh(File.join(root, "scripts", "generate-screenshot-backgrounds"), "ios")
        frame_screenshots(path: screenshots_dir)
        # Las dos primeras capturas no salen de la app: se componen aparte, y después de
        # frameit porque escriben directamente sus *_framed.png.
        sh(File.join(root, "scripts", "compose-store-screenshots"), "ios")

        # frameit no falla cuando no puede leer los títulos (pasa si el locale no es UTF-8):
        # simplemente no enmarca nada, y las capturas sin marco no sirven para la ficha.
        enmarcadas = Dir.glob(File.join(output_dir, "*_framed.png"))
        UI.user_error!("❌ frameit no generó ninguna captura enmarcada de #{nombre}.") if enmarcadas.empty?
      end

      Dir.glob(File.join(output_dir, "*.png")).each { |captura| FileUtils.mv(captura, listas) }
      # Apagarlo libera la RAM del runner para el siguiente simulador (y para el emulador de Android).
      sh("xcrun simctl shutdown #{udid} || true")
    end

    Dir.glob(File.join(listas, "*.png")).each { |captura| FileUtils.mv(captura, output_dir) }
    FileUtils.remove_entry(listas)

    capturas = Dir.glob(File.join(output_dir, "*.png"))
    UI.success("✅ #{capturas.length} capturas guardadas en #{output_dir}")
  end

  desc "Sube a App Store Connect las capturas ya generadas (sin tocar el binario)"
  lane :upload_screenshots do |options|
    app_identifier = string_option(options, :app_identifier, env_var: "APP_IDENTIFIER", required: true)

    screenshots_path = File.join(sh("git", "rev-parse", "--show-toplevel", log: false).strip, "fastlane", "screenshots")

    load_api_key()

    # deliver detecta los *_framed.png y omite las capturas sin marco de la misma carpeta.
    upload_to_app_store(
      app_identifier: app_identifier,
      screenshots_path: screenshots_path,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
    )

    UI.success("✅ Capturas subidas a App Store Connect")
  end

  desc "Carga la API Key de App Store Connect para autenticación"
  lane :load_api_key do |options|
    key_id = string_option(options, :key_id, env_var: "APP_STORE_CONNECT_API_KEY_ID", required: true)
    issuer_id = string_option(options, :issuer_id, env_var: "APP_STORE_CONNECT_ISSUER_ID", required: true)
    key_content = string_option(options, :key_content, env_var: "APP_STORE_CONNECT_API_KEY_CONTENT", required: true)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
      in_house: false, # Se especifica false para App Store (nosotros), true para Enterprise
    )
  end

  desc "Sube la aplicación a TestFlight (requiere IPA)"
  lane :upload do |options|
    # Obtener path del IPA: lane_context si existe, sino argumento custom
    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH] || string_option(options, :ipa_path, env_var: "IPA_PATH")

    # Validar que existe
    UI.user_error!("❌ No se encontró IPA. Proporciona ipa_path:<path> o ejecuta build primero") unless ipa_path
    UI.user_error!("❌ El archivo IPA no existe en: #{ipa_path}") unless File.exist?(ipa_path)

    UI.success("✅ Usando IPA: #{ipa_path}")

    # Cargar API key
    load_api_key()

    # Upload a TestFlight
    upload_to_testflight(
      ipa: ipa_path,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )

    UI.success("✅ IPA subido a TestFlight exitosamente")
  end

  desc "Build completo y upload a TestFlight"
  lane :deploy do
    build()
    upload()
  end
end
