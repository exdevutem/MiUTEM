import "../fastlane/src/helpers.rb"

platform :mac do
  desc "Asegura que exista un keychain limpio para importar los certificados de Apple"
  lane :ensure_keychain do
    delete_keychain(name: ENV["KEYCHAIN_NAME"]) if File.exist? File.expand_path("~/Library/Keychains/#{ENV["KEYCHAIN_NAME"]}")
    create_keychain(
      name: ENV["KEYCHAIN_NAME"],
      password: ENV["KEYCHAIN_PASSWORD"],
      unlock: true,
      timeout: 0,
      default_keychain: true,
      add_to_search_list: true
    )
  end

  desc "Asegura que existan los certificados WWDR de Apple en el keychain"
  lane :ensure_wwdr do
    keychain_path = File.expand_path("~/Library/Keychains/#{ENV["KEYCHAIN_NAME"]}")
    wwdr_certs = {
      "AppleWWDRCAG3.cer" => "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer",
      "AppleWWDRCAG6.cer" => "https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer",
      "AppleRootCA.cer"   => "https://www.apple.com/appleca/AppleIncRootCertificate.cer",
    }

    wwdr_certs.each do |filename, url|
      path = "/tmp/#{filename}"
      sh("curl", "-fsSL", "-o", path, url) unless File.exist?(path)
      sh("security", "import", path, "-k", keychain_path, "-T", "/usr/bin/codesign")
    end
  end

  desc "Sincroniza certificados y perfiles de aprovisionamiento para macOS"
  lane :sync_certificates do |options|
    readonly = bool_option(options, :readonly, env_var: "IS_CI", default: false)
    type = string_option(options, :type, env_var: "MATCH_TYPE", default: "development")
    skip_keychain_setup = bool_option(options, :skip_keychain_setup, default: false)
    skip_wwdr_setup = bool_option(options, :skip_wwdr_setup, default: false)

    unless skip_keychain_setup
      ensure_keychain()
    end

    unless skip_wwdr_setup
      ensure_wwdr()
    end

    match(
      app_identifier: [ENV["APP_IDENTIFIER"]],
      type: type,
      platform: "macos",
      git_url: ENV["MATCH_REPO"],
      readonly: readonly,
      keychain_name: ENV["KEYCHAIN_NAME"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )
  end

  desc "Configura Signing Settings para Xcode macOS"
  lane :configure_signing do
    profile_type = case ENV["MATCH_TYPE"]
                    when "development" then "Development"
                    when "appstore" then "AppStore"
                    when "ad-hoc" then "AdHoc"
                    when "enterprise" then "Enterprise"
                    else "Development"
                   end
    profile_name = "match #{profile_type} #{ENV["APP_IDENTIFIER"]}"
    code_sign_identity = ENV["MATCH_TYPE"] == "development" ? "Apple Development" : "Apple Distribution"

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "./macos/Runner.xcodeproj",
      team_id: ENV["TEAM_ID"],
      bundle_identifier: ENV["APP_IDENTIFIER"],
      profile_name: profile_name,
      code_sign_identity: code_sign_identity
    )
  end
end
